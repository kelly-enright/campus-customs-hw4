# Campus Customs — environment template
#
# Copy this file to `.env` in this same directory and fill in the real value:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed.
#
# The backend looks for a .env at the project root (this folder) or one directory
# above it, so either location works.
#
# Without this key the catalogue, accounts, and browsing all still work —
# only the chat assistant returns a 502.

# API key for the Portkey gateway, which fronts the chat model.
PORTKEY_API_KEY=your_portkey_api_key_here

# Optional. The gateway currently routes every request to the same upstream model
# regardless of the name sent, so this is effectively a label. Defaults to gpt-5-mini.
# CAMPUS_CUSTOMS_MODEL=gpt-5-mini
